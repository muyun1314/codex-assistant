{
  "$schema": "https://raw.githubusercontent.com/nicedoc/schema/master/capability.json",
  "identifier": "default",
  "description": "Default capability for Codex Assistant",
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:*"]
  },
  "permissions": [
    "default",
    "core:default",
    "shell:default",
    "core:event:default",
    "core:event:allow-listen",
    "core:event:allow-emit",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-close"
  ]
}
