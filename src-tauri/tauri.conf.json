{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "Codex Assistant",
  "version": "1.2.0",
  "identifier": "com.muyun.codex-assistant",
  "build": {
    "beforeBuildCommand": "echo Build frontend skipped",
    "beforeDevCommand": "echo Dev frontend skipped",
    "frontendDist": "frontend"
  },
  "app": {
    "windows": [
      {
        "title": "Codex Assistant",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "decorations": true,
        "resizable": true,
        "transparent": false,
        "visible": false,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/node/node.exe",
      "../proxy.mjs",
      "../ui-server.mjs",
      "../ui-frontend.html",
      "../ui-frontend.css",
      "../ui-frontend.js",
      "../ui-favicon.ico",
      "../src/crypto-store.mjs",
      "../src/protocol.mjs",
      "../src/rate-limit.mjs",
      "../src/shared.mjs",
      "../src/store.mjs",
      "../src/streaming.mjs",
      "../src/updater.mjs",
      "../src/web-fetch.mjs",
      "../version.json",
      "../env.example",
      "../proxy-models.example.json",
      "../LICENSE",
      "../README.md",
      "../README.zh-CN.md"
    ],
    "windows": {
      "nsis": {
        "installMode": "both",
        "displayLanguageSelector": true,
        "languages": [
          "SimpChinese",
          "English"
        ]
      }
    }
  }
}
