{
  "name": "codex-assistant",
  "version": "1.1.0",
  "description": "Zero-dependency local proxy: translates OpenAI Responses API to Chat Completions for DeepSeek, Xiaomi MiMo, and OpenAI behind a single base_url — Codex Assistant",
  "main": "proxy.mjs",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wujfeng712-ui/Codex-Assistant.git"
  },
